<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>MarkdownPreviewer.Infrastructure</RootNamespace>
    <!-- Registry + ShellExecute live here; no UI framework. -->
    <UseWindowsForms>false</UseWindowsForms>
    <!--
      Must be a 2-4 part version and should match the minimum OS the installer
      enforces (Windows 10 1809). A malformed value like "7" trips CA1418 and,
      worse, makes the platform analyzer treat the assembly as platform-neutral,
      producing a CA1416 for every Windows API call.
    -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkdownPreviewer.Application\MarkdownPreviewer.Application.csproj" />
  </ItemGroup>

</Project>
