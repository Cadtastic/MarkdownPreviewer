<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>MarkdownPreviewer.Shell</RootNamespace>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Matches the installer's Windows 10 1809 minimum; see Infrastructure.csproj. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <!--
      COM hosting generates MarkdownPreviewer.Shell.comhost.dll, which is what
      regsvr32 registers and what InprocServer32 must point at.

      SelfContained MUST stay false. .NET does not support COM hosting from a
      self-contained deployment: regsvr32 fails with 0x80008093. The consequence
      is a real deployment requirement — the target machine needs the .NET 8
      Desktop Runtime — which the installer checks for. See docs/architecture.md.
    -->
    <EnableComHosting>true</EnableComHosting>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      Explorer's preview host loads many extensions into one process. Rooting our
      dependency resolution to our own folder avoids picking up a sibling
      extension's assemblies.
    -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkdownPreviewer.Infrastructure\MarkdownPreviewer.Infrastructure.csproj" />
    <ProjectReference Include="..\MarkdownPreviewer.Rendering\MarkdownPreviewer.Rendering.csproj" />
  </ItemGroup>

  <!-- Ship the render assets beside the DLL so InstallDirectoryAssetCatalog finds them. -->
  <ItemGroup>
    <Content Include="..\..\assets\web\**\*">
      <Link>assets\web\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
